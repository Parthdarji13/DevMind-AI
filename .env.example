# DevMind AI — Environment Configuration Template
# Copy this file to .env and configure for your local environment.
# DO NOT COMMIT REAL API KEYS OR SECRETS TO SOURCE CONTROL.

# Backend Server Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Repository & Ingestion Limits (PRD Section 17.4 / 17.10)
MAX_ZIP_MB=100
MAX_FILES=3000
MAX_FILE_KB=1000
RETENTION_DAYS=7
GIT_CLONE_TIMEOUT_SECONDS=60

# Storage Directories
DATA_DIR=./data
TEMP_STORAGE_DIR=./data/temp_repos
INDICES_DIR=./data/indices

# LLM Provider Configuration ("google_genai" | "openai" | "groq" | "mock")
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.5-flash

# API Keys (leave as placeholder; supply in local .env)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Embedding Configuration ("local" [fast hash projection] | "sentence_transformers" [neural dense] | "google_genai" | "openai")
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-projection-384

# Authentication & Security
# Generate a strong 32+ character random secret (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET=your_32_character_minimum_random_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# MongoDB Database Configuration (Atlas or Local)
# Supply your MongoDB Atlas connection string to store users, repositories, and chat history in MongoDB:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=devmind_ai

